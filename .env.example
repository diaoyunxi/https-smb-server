# HTTPS SMB Server 环境变量配置
# 复制此文件为 .env 并修改实际值

# 存储根目录（默认: ./data）
HTTPS_SMB_ROOT=./data

# 监听地址（默认: 0.0.0.0）
HTTPS_SMB_HOST=0.0.0.0

# 监听端口（默认: 8080）
HTTPS_SMB_PORT=8080

# 分块上传大小（字节，默认: 8MB）
HTTPS_SMB_CHUNK_SIZE=8388608

# 下载分块大小（字节，默认: 4MB）
HTTPS_SMB_DOWNLOAD_CHUNK=4194304

# ===== 安全配置 =====
# Bearer Token 认证令牌（强烈建议设置）
# 未设置时所有 API 无需认证即可访问！
# 生成随机 token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HTTPS_SMB_TOKEN=your-secret-token-here
