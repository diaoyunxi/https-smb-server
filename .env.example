# ============================================================
# https-smb-server 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== 服务配置 =====
# 绑定地址（默认 0.0.0.0，生产环境建议 127.0.0.1）
HTTPS_SMB_HOST=0.0.0.0
# 服务端口（默认 8080）
HTTPS_SMB_PORT=8080

# ===== 存储配置 =====
# 数据根目录（默认 ./data）
HTTPS_SMB_ROOT=./data
# 上传分块大小（字节，默认 8MB）
HTTPS_SMB_CHUNK_SIZE=8388608
# 下载分块大小（字节，默认 4MB）
HTTPS_SMB_DOWNLOAD_CHUNK=4194304

# ===== 认证（可选） =====
# Bearer Token（留空则无需认证）
AUTH_TOKEN=

# ===== TLS/SSL（可选） =====
# SSL 证书路径
# SSL_CERT_FILE=
# SSL 密钥路径
# SSL_KEY_FILE=
